# Activa el modo de depuración solo durante el desarrollo.
FLASK_DEBUG=true
# Conexión PostgreSQL usando el adaptador Psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres:CAMBIA_TU_PASSWORD@localhost:5432/mini-ecomerce-games
# Puerto local del servidor Flask.
PORT=6072
# Orígenes locales permitidos para solicitudes del navegador.
FRONTEND_ORIGINS=http://localhost:5475,http://127.0.0.1:5475
